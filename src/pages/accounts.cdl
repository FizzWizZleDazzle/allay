import "lumen.cdl";
import "std/json";
import "std/time";

// Signing in to a Microsoft account, and staying signed in.
//
// Allay uses the device-code flow published for Minecraft for Nintendo Switch
// (client id 00000000441CC96B). Mojang stopped taking registrations for new
// launcher applications, so a launcher that is not one of theirs has no client
// id of its own to offer; this is the id the open-source launchers settled on.
// A client id is a public identifier rather than a secret, and the account
// being signed in is the user's own: Allay never sees the password, only the
// tokens Microsoft hands back after the user approves the code in a browser.
//
// The flow is five chained requests, each one feeding the next:
//
//   1. login.live.com/oauth20_connect.srf   -> device code + user code
//   2. login.live.com/oauth20_token.srf     -> Microsoft access token (polled)
//   3. user.auth.xboxlive.com/user/authenticate -> Xbox Live token + user hash
//   4. xsts.auth.xboxlive.com/xsts/authorize    -> XSTS token
//   5. api.minecraftservices.com/authentication/login_with_xbox -> game token
//
// then a sixth request reads the profile for the name and UUID the game is
// launched with. Every step is one lumen::http call routed back by tag.
//
// The game token lasts a day. Step 2 also hands back a refresh token, which
// Allay keeps; when the game token is close to running out, at start-up or
// before a launch, the refresh token buys a new Microsoft token with no
// browser involved and steps 3 to 5 run again from it. That is a refresh: the
// same chain with `account_mode` set to "refresh", ending in an update of the
// stored tokens instead of a new account.
//
// Tokens never go into accounts.json, which only names the accounts. They
// live in private/tokens.json, in a directory only this user can read.

fn accounts_client_id() -> string {
    return "00000000441CC96B";
}

fn accounts_scope() -> string {
    return "service::user.auth.xboxlive.com::MBI_SSL";
}

fn accounts_store_path() -> string {
    return files::data_dir() + "/accounts.json";
}

fn accounts_empty_doc() -> string {
    return "{\"version\":1,\"active\":\"\",\"next_seq\":1,\"accounts\":[]}";
}

// A game token with less time left than this is refreshed before a launch,
// so a session does not start on a token that runs out minutes later.
fn accounts_launch_margin() -> int {
    return 30 * 60;
}

// At start-up only a token that is about to run out is refreshed; one with
// hours left is refreshed when a launch needs it.
fn accounts_startup_margin() -> int {
    return 2 * 60 * 60;
}

// --- Setup -------------------------------------------------------------------

fn accounts_init() -> bool {
    lumen::on("click", "account-signin", "accounts_signin_clicked");
    lumen::on("click", "account-cancel", "accounts_cancel_clicked");
    lumen::on("click", "account-copy-code", "accounts_copy_code");
    lumen::on("click", "account-open-browser", "accounts_open_browser");
    lumen::on("timer", "account-poll", "accounts_poll_tick");
    lumen::on("timer", "account-wake", "accounts_wake_tick");
    signal<int>("account_wake_left").set(0);

    lumen::on("http", "msa-devicecode", "accounts_on_devicecode");
    lumen::on("http", "msa-token", "accounts_on_token");
    lumen::on("http", "msa-refresh", "accounts_on_refresh_token");
    lumen::on("http", "xbl-auth", "accounts_on_xbl");
    lumen::on("http", "xsts-auth", "accounts_on_xsts");
    lumen::on("http", "mc-login", "accounts_on_mc_login");
    lumen::on("http", "mc-profile", "accounts_on_profile");

    signal<string>("account_flow").set("");
    signal<string>("account_status").set("");
    signal<string>("account_code").set("");
    signal<string>("account_url").set("");
    signal<string>("account_mode").set("");
    signal<string>("account_refresh_id").set("");
    signal<string>("account_after_refresh").set("");

    accounts_secure_dir();
    accounts_move_tokens();
    accounts_refresh();
    accounts_refresh_if_due(accounts_startup_margin(), "");
    return true;
}

// --- Storage ------------------------------------------------------------------

fn accounts_read_doc() {
    let text = files::read(accounts_store_path());
    if text.trim() == "" {
        text = accounts_empty_doc();
    }
    let parsed = lumen::parse_json(text);
    if (parsed is {string: any}) == false {
        parsed = lumen::parse_json(accounts_empty_doc());
    }
    return parsed;
}

fn accounts_list_of(d) {
    let m = d as {string: any};
    return m["accounts"] as any[];
}

fn accounts_persist(d) -> bool {
    let text = json::stringify(d);
    return files::write(accounts_store_path(), text);
}

fn accounts_find(list, id: string) -> int {
    let i = 0;
    for entry in list {
        if ((entry as {string: any})["id"] as string) == id {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// --- Token storage --------------------------------------------------------------

fn accounts_secret_dir() -> string {
    return files::data_dir() + "/private";
}

fn accounts_tokens_path() -> string {
    return accounts_secret_dir() + "/tokens.json";
}

// The tokens directory is closed to other users of the machine. Lumen writes
// a file by replacing it, so a mode on the file itself would not survive the
// next write; the directory's mode does. Where there is no chmod, as on
// Windows, the start fails quietly and the per-user data directory is what
// keeps the file private.
fn accounts_secure_dir() -> bool {
    files::mkdir(accounts_secret_dir());
    process::start("chmod", ["700", accounts_secret_dir()], "chmod-private",
                   process::StartOptions::default());
    return true;
}

fn accounts_read_tokens() {
    let parsed = lumen::parse_json(files::read(accounts_tokens_path()));
    if (parsed is {string: any}) == false {
        parsed = lumen::parse_json("{\"version\":1,\"tokens\":{}}");
    }
    return parsed as {string: any};
}

fn accounts_write_tokens(t) -> bool {
    files::mkdir(accounts_secret_dir());
    return files::write(accounts_tokens_path(), json::stringify(t));
}

// The stored tokens of one account, or an empty map.
fn accounts_tokens_of(id: string) {
    let all = accounts_read_tokens()["tokens"] as {string: any};
    if all.contains(id) {
        return all[id] as {string: any};
    }
    return new_map();
}

fn accounts_token_field(id: string, key: string) -> string {
    let t = accounts_tokens_of(id) as {string: any};
    if t.contains(key) {
        return t[key] as string;
    }
    return "";
}

fn accounts_expires_at(id: string) -> int {
    let t = accounts_tokens_of(id) as {string: any};
    if t.contains("expires_at") {
        return t["expires_at"] as int;
    }
    return 0;
}

fn accounts_set_tokens(id: string, access: string, refresh: string, expires_at: int) -> bool {
    let t = accounts_read_tokens();
    let all = t["tokens"] as {string: any};
    let entry = new_map();
    entry["access_token"] = access;
    entry["refresh_token"] = refresh;
    entry["expires_at"] = expires_at;
    all[id] = entry;
    return accounts_write_tokens(t);
}

fn accounts_drop_tokens(id: string) -> bool {
    let t = accounts_read_tokens();
    let all = t["tokens"] as {string: any};
    if all.contains(id) {
        all.remove(id);
        accounts_write_tokens(t);
    }
    return true;
}

// Allay used to keep the tokens in accounts.json beside the names. They move
// to the private file on the first start that finds them there; their age is
// unknown, so the game token counts as expired and is refreshed before the
// next launch.
fn accounts_move_tokens() -> bool {
    let d = accounts_read_doc();
    let moved = false;
    for entry in accounts_list_of(d) {
        let a = entry as {string: any};
        if a.contains("access_token") || a.contains("refresh_token") {
            let access = "";
            let refresh = "";
            if a.contains("access_token") {
                access = a["access_token"] as string;
                a.remove("access_token");
            }
            if a.contains("refresh_token") {
                refresh = a["refresh_token"] as string;
                a.remove("refresh_token");
            }
            accounts_set_tokens(a["id"] as string, access, refresh, 0);
            moved = true;
        }
    }
    if moved {
        accounts_persist(d);
    }
    return true;
}

// --- What the pages show --------------------------------------------------------

// Rebuilds the rows the accounts page renders and the summary the sidebar
// shows, so both read from one place.
fn accounts_refresh() -> bool {
    let d = accounts_read_doc();
    let m = d as {string: any};
    let active = m["active"] as string;
    let list = accounts_list_of(d);
    let rows = [];
    let active_name = "Not signed in";
    let active_kind = "No account selected";

    for entry in list {
        let a = entry as {string: any};
        let id = a["id"] as string;
        let kind = accounts_kind_label(a["type"] as string);
        if accounts_needs_signin(a) {
            kind = "Signed out. Sign in again to play online.";
        }
        if id == active {
            a["state"] = "Active";
            active_name = a["name"] as string;
            active_kind = kind;
            if accounts_needs_signin(a) {
                active_kind = "Signed out";
            }
        } else {
            a["state"] = "";
        }
        a["kind_label"] = kind;
        rows.push(entry);
    }

    signal_array("accounts").set(rows);
    accounts_bind_rows(rows);
    signal<string>("accounts_empty").set("");
    if rows.len() == 0 {
        signal<string>("accounts_empty").set("1");
    }
    signal<string>("account_name").set(active_name);
    signal<string>("account_kind").set(active_kind);
    home_refresh();
    return true;
}

// A row's buttons carry "use-account|<id>" and "drop-account|<id>". Routing
// matches an id exactly, or an instance suffix after a colon, so each row's
// ids are registered here after the array signal is written.
fn accounts_bind_rows(rows) -> bool {
    for entry in rows {
        let id = (entry as {string: any})["id"] as string;
        lumen::on("click", "use-account|" + id, "accounts_use_clicked");
        lumen::on("click", "drop-account|" + id, "accounts_drop_clicked");
    }
    return true;
}

fn accounts_kind_label(kind: string) -> string {
    if kind == "msa" {
        return "Microsoft account";
    }
    return "Offline";
}

fn accounts_needs_signin(a) -> bool {
    let m = a as {string: any};
    if m.contains("needs_signin") {
        return m["needs_signin"] as bool;
    }
    return false;
}

// The account the launcher plays as. Empty fields mean nobody is signed in,
// and launch falls back to offline play.
fn accounts_active() {
    let d = accounts_read_doc();
    let m = d as {string: any};
    let active = m["active"] as string;
    let list = accounts_list_of(d);
    let found = new_map();
    for entry in list {
        let a = entry as {string: any};
        if (a["id"] as string) == active {
            found = entry;
        }
    }
    return found;
}

// The game token of the active account, or "" when there is none.
fn accounts_active_token() -> string {
    let a = accounts_active() as {string: any};
    if a.contains("id") == false {
        return "";
    }
    return accounts_token_field(a["id"] as string, "access_token");
}

// --- Staying signed in ------------------------------------------------------------

// Called before a launch with the name of what to do once the active account
// can play. Returns true when it can play now, and false when a refresh has
// started; the refresh ends by calling accounts_continue(after).
fn accounts_ensure_fresh(after: string) -> bool {
    if signal<string>("account_mode").get() == "refresh" {
        // A refresh is already on its way; the launch waits for it.
        signal<string>("account_after_refresh").set(after);
        return false;
    }
    return accounts_refresh_if_due(accounts_launch_margin(), after) == false;
}

// Starts a refresh of the active account when its game token has less than
// `margin` seconds left. Returns whether one started.
fn accounts_refresh_if_due(margin: int, after: string) -> bool {
    if signal<string>("account_flow").get() != "" {
        // A sign-in is under way and owns the chain; it brings fresh tokens.
        return false;
    }
    let a = accounts_active() as {string: any};
    if a.contains("id") == false || (a["type"] as string) != "msa" {
        return false;
    }
    if accounts_needs_signin(a) {
        return false;
    }
    let id = a["id"] as string;
    let left = accounts_expires_at(id) - time::now();
    if left > margin && accounts_token_field(id, "access_token") != "" {
        return false;
    }
    let refresh = accounts_token_field(id, "refresh_token");
    if refresh == "" {
        accounts_mark_signed_out(id);
        return false;
    }

    signal<string>("account_mode").set("refresh");
    signal<string>("account_refresh_id").set(id);
    signal<string>("account_after_refresh").set(after);
    let body = "client_id=" + accounts_client_id()
             + "&grant_type=refresh_token"
             + "&scope=" + accounts_form_escape(accounts_scope())
             + "&refresh_token=" + accounts_form_escape(refresh);
    accounts_post_form("https://login.live.com/oauth20_token.srf", body, "msa-refresh");
    return true;
}

fn accounts_on_refresh_token(tag: string, response: any) -> bool {
    let r = response as {string: any};
    let status = r["status"] as int;
    if status == 0 || status >= 500 {
        return accounts_fail("Microsoft could not be reached");
    }
    let parsed = lumen::parse_json(r["body"] as string);
    if (parsed is {string: any}) == false {
        return accounts_fail("Microsoft could not be reached");
    }
    let body = parsed as {string: any};
    if body.contains("error") {
        // invalid_grant is Microsoft's answer for a refresh token that was
        // revoked, ran out after months unused, or died with a password
        // change. Only a new sign-in recovers from it.
        if (body["error"] as string) == "invalid_grant" {
            return accounts_refresh_failed(true, "Microsoft ended the sign-in. Sign in again.");
        }
        return accounts_fail("Microsoft refused to renew the sign-in");
    }
    if body.contains("access_token") == false {
        return accounts_fail("Microsoft's reply carried no token");
    }
    signal<string>("account_msa_token").set(body["access_token"] as string);
    // Microsoft may hand back a new refresh token, and the old one stops
    // working once it has; when it does not, the old one stays good.
    if body.contains("refresh_token") {
        signal<string>("account_refresh_token").set(body["refresh_token"] as string);
    } else {
        signal<string>("account_refresh_token").set(
            accounts_token_field(signal<string>("account_refresh_id").get(), "refresh_token"));
    }
    return accounts_xbox_step();
}

// A refresh that could not finish. `signed_out` means the tokens are no good
// any more and only a new sign-in helps; otherwise Microsoft was out of reach
// and the tokens Allay has are kept for the next try.
fn accounts_refresh_failed(signed_out: bool, message: string) -> bool {
    let id = signal<string>("account_refresh_id").get();
    let after = signal<string>("account_after_refresh").get();
    signal<string>("account_mode").set("");
    signal<string>("account_refresh_id").set("");
    signal<string>("account_after_refresh").set("");
    accounts_clear_secrets();
    if signed_out {
        accounts_mark_signed_out(id);
    }
    signal<string>("account_status").set(message);
    if after != "" {
        accounts_continue(after, signed_out, message);
    }
    return false;
}

// Marks an account as needing a new sign-in and forgets its tokens.
fn accounts_mark_signed_out(id: string) -> bool {
    let d = accounts_read_doc();
    let list = accounts_list_of(d);
    let at = accounts_find(list, id);
    if at >= 0 {
        let a = list[at] as {string: any};
        a["needs_signin"] = true;
        accounts_persist(d);
    }
    accounts_drop_tokens(id);
    accounts_refresh();
    return true;
}

// Whatever waited on the refresh runs now. Only a launch waits today.
fn accounts_continue(after: string, signed_out: bool, message: string) -> bool {
    if after == "launch" {
        return mods_launch_after_refresh(signed_out, message);
    }
    return false;
}

// Form bodies carry the tokens, and a refresh token holds characters a form
// reads as separators, so everything outside the unreserved set is escaped.
fn accounts_form_escape(text: string) -> string {
    let keep = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~";
    let ascii = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    let hex = "0123456789ABCDEF";
    let out = "";
    for c in text.chars() {
        if keep.contains(c) {
            out = out + c;
        } else if ascii.index_of(c) is Some(at) {
            let code = at + 32;
            out = out + "%" + hex.char_at(code / 16) + hex.char_at(code % 16);
        }
    }
    return out;
}

// --- Starting the flow ---------------------------------------------------------

fn accounts_signin_clicked(id: string) -> bool {
    if signal<string>("account_flow").get() != "" {
        return false;
    }
    if signal<string>("account_mode").get() == "refresh" {
        signal<string>("account_status").set("Renewing the saved sign-in. Try again in a moment.");
        return false;
    }
    signal<string>("account_mode").set("signin");
    signal<string>("account_flow").set("devicecode");
    signal<string>("account_status").set("Asking Microsoft for a code...");
    signal<string>("account_code").set("");
    signal<int>("account_retries").set(0);

    let body = "client_id=" + accounts_client_id()
             + "&scope=" + accounts_form_escape(accounts_scope())
             + "&response_type=device_code";
    accounts_post_form("https://login.live.com/oauth20_connect.srf", body, "msa-devicecode");
    return true;
}

// The code itself is left in its signal: emptying it in the tick that closes
// the panel around it takes the app down (lumen-fx/lumen#613). The next
// sign-in empties it before it shows.
fn accounts_cancel_clicked(id: string) -> bool {
    lumen::cancel_timer("account-poll");
    signal<string>("account_flow").set("");
    signal<string>("account_mode").set("");
    signal<string>("account_status").set("");
    return true;
}

fn accounts_copy_code(id: string) -> bool {
    lumen::clipboard_write(signal<string>("account_code").get());
    signal<string>("account_status").set("Code copied. Enter it in the browser.");
    return true;
}

fn accounts_open_browser(id: string) -> bool {
    lumen::open_url(signal<string>("account_url").get());
    return true;
}

// --- Request helpers ------------------------------------------------------------

fn accounts_request(url: string, tag: string, content_type: string, body: string) -> bool {
    let request = {"method": "POST", "url": url, "tag": tag, "body": body,
                   "timeout_ms": "30000", "header:Content-Type": content_type,
                   "header:Accept": "application/json"};
    lumen::http(request);
    return accounts_keep_awake();
}

// Lumen 0.0.11 delivers an http reply that arrives while the app is idle
// only on the next tick something else causes (lumen-fx/lumen#612), so a
// sign-in would stall until the user touched the window. A short timer keeps
// the app ticking for as long as a request can take; a timer that re-arms
// itself does fire on time.
fn accounts_keep_awake() -> bool {
    let idle = signal<int>("account_wake_left").get() == 0;
    signal<int>("account_wake_left").set(120);
    if idle {
        lumen::set_timeout("account-wake", 250);
    }
    return true;
}

fn accounts_wake_tick(name: string) -> bool {
    let left = signal<int>("account_wake_left").get() - 1;
    if left < 0 {
        left = 0;
    }
    signal<int>("account_wake_left").set(left);
    if left > 0 {
        lumen::set_timeout("account-wake", 250);
    }
    return true;
}

fn accounts_post_form(url: string, body: string, tag: string) -> bool {
    return accounts_request(url, tag, "application/x-www-form-urlencoded", body);
}

fn accounts_post_json(url: string, body: string, tag: string) -> bool {
    return accounts_request(url, tag, "application/json", body);
}

fn accounts_get(url: string, tag: string, bearer: string) -> bool {
    let authorization = "Bearer " + bearer;
    let request = {"method": "GET", "url": url, "tag": tag, "timeout_ms": "30000",
                   "header:Authorization": authorization, "header:Accept": "application/json"};
    lumen::http(request);
    return accounts_keep_awake();
}

// Bounded, so a code Microsoft keeps rejecting for some other reason cannot
// spin here forever.
fn accounts_renew() -> bool {
    let tries = signal<int>("account_retries").get();
    if tries >= 3 {
        return accounts_fail("The code kept expiring. Start the sign-in again when you are ready.");
    }
    signal<int>("account_retries").set(tries + 1);
    signal<string>("account_code").set("");
    signal<string>("account_status").set("That code expired. Fetching a new one...");
    let body = "client_id=" + accounts_client_id()
             + "&scope=" + accounts_form_escape(accounts_scope())
             + "&response_type=device_code";
    accounts_post_form("https://login.live.com/oauth20_connect.srf", body, "msa-devicecode");
    return true;
}

// A step of the chain went wrong. During a sign-in the message is shown and
// the flow ends; during a refresh Microsoft is treated as out of reach, and
// the saved tokens stay for the next try.
fn accounts_fail(message: string) -> bool {
    if signal<string>("account_mode").get() == "refresh" {
        return accounts_refresh_failed(false, message);
    }
    lumen::cancel_timer("account-poll");
    signal<string>("account_flow").set("");
    signal<string>("account_mode").set("");
    signal<string>("account_status").set(message);
    accounts_clear_secrets();
    return false;
}

// A step that answered with a refusal rather than an outage. During a refresh
// that means the saved sign-in is no good any more.
fn accounts_refused(message: string) -> bool {
    if signal<string>("account_mode").get() == "refresh" {
        return accounts_refresh_failed(true, message + " Sign in again.");
    }
    return accounts_fail(message);
}

// A reply that is a refusal: any 4xx. A 5xx or no reply at all is an outage.
fn accounts_is_refusal(r) -> bool {
    let status = (r as {string: any})["status"] as int;
    return status >= 400 && status < 500;
}

// --- 1. Device code ------------------------------------------------------------

fn accounts_on_devicecode(tag: string, response: any) -> bool {
    let r = response as {string: any};
    if (r["ok"] as bool) == false {
        return accounts_fail("Microsoft would not issue a code");
    }
    let raw = r["body"] as string;
    let parsed = lumen::parse_json(raw);
    if (parsed is {string: any}) == false {
        return accounts_fail("Microsoft's reply could not be read");
    }
    let body = parsed as {string: any};
    if body.contains("device_code") == false {
        return accounts_fail("Microsoft's reply carried no device code");
    }

    signal<string>("account_device_code").set(body["device_code"] as string);
    signal<string>("account_code").set(body["user_code"] as string);
    signal<string>("account_url").set(body["verification_uri"] as string);
    signal<string>("account_flow").set("waiting");
    signal<string>("account_status").set("Enter the code in your browser, then wait here.");

    let interval = 5;
    if body.contains("interval") {
        interval = body["interval"] as int;
    }
    signal<int>("account_interval").set(interval);
    lumen::set_timeout("account-poll", interval * 1000);
    return true;
}

// --- 2. Token, polled ------------------------------------------------------------

fn accounts_poll_tick(name: string) -> bool {
    if signal<string>("account_flow").get() != "waiting" {
        return false;
    }
    let body = "client_id=" + accounts_client_id()
             + "&device_code=" + accounts_form_escape(signal<string>("account_device_code").get())
             + "&grant_type=" + accounts_form_escape("urn:ietf:params:oauth:grant-type:device_code");
    accounts_post_form("https://login.live.com/oauth20_token.srf", body, "msa-token");
    return true;
}

fn accounts_on_token(tag: string, response: any) -> bool {
    let r = response as {string: any};
    let raw = r["body"] as string;
    let parsed = lumen::parse_json(raw);
    if (parsed is {string: any}) == false {
        return accounts_fail("Microsoft's reply could not be read");
    }
    let body = parsed as {string: any};

    // The pending reply is an HTTP error carrying a named reason, so the error
    // name decides whether to keep waiting rather than the status alone.
    if body.contains("error") {
        let err = body["error"] as string;
        if err == "authorization_pending" {
            let interval = signal<int>("account_interval").get();
            lumen::set_timeout("account-poll", interval * 1000);
            return true;
        }
        if err == "slow_down" {
            let slower = signal<int>("account_interval").get() + 5;
            signal<int>("account_interval").set(slower);
            lumen::set_timeout("account-poll", slower * 1000);
            return true;
        }
        if err == "authorization_declined" {
            return accounts_fail("Sign-in was declined");
        }
        // A code lives about fifteen minutes. Walking away for longer than
        // that is ordinary, so an expired code fetches another one rather than
        // ending the sign-in and making the user start it over. Microsoft
        // spells the same condition both ways.
        if err == "expired_token" {
            return accounts_renew();
        }
        if err == "invalid_grant" {
            return accounts_renew();
        }
        return accounts_fail("Microsoft refused the sign-in: " + err);
    }

    if body.contains("access_token") == false {
        return accounts_fail("Microsoft's reply carried no token");
    }

    signal<string>("account_msa_token").set(body["access_token"] as string);
    signal<string>("account_refresh_token").set("");
    if body.contains("refresh_token") {
        signal<string>("account_refresh_token").set(body["refresh_token"] as string);
    }
    signal<string>("account_flow").set("xbox");
    return accounts_xbox_step();
}

// --- 3. Xbox Live ----------------------------------------------------------------

// From a Microsoft token, sign in to Xbox Live. Shared by a sign-in and a
// refresh.
fn accounts_xbox_step() -> bool {
    accounts_progress("Signing in to Xbox Live...");
    let payload = "{\"Properties\":{\"AuthMethod\":\"RPS\",\"SiteName\":\"user.auth.xboxlive.com\",\"RpsTicket\":\""
                + signal<string>("account_msa_token").get()
                + "\"},\"RelyingParty\":\"http://auth.xboxlive.com\",\"TokenType\":\"JWT\"}";
    accounts_post_json("https://user.auth.xboxlive.com/user/authenticate", payload, "xbl-auth");
    return true;
}

// Progress text is for the sign-in the user is watching; a refresh runs
// without a word unless it fails.
fn accounts_progress(message: string) -> bool {
    if signal<string>("account_mode").get() != "refresh" {
        signal<string>("account_status").set(message);
    }
    return true;
}

fn accounts_on_xbl(tag: string, response: any) -> bool {
    let r = response as {string: any};
    if (r["ok"] as bool) == false {
        if accounts_is_refusal(r) {
            return accounts_refused("Xbox Live refused the token.");
        }
        return accounts_fail("Xbox Live could not be reached");
    }
    let raw = r["body"] as string;
    let parsed = lumen::parse_json(raw);
    if (parsed is {string: any}) == false {
        return accounts_fail("Xbox Live's reply could not be read");
    }
    let body = parsed as {string: any};
    if body.contains("Token") == false {
        return accounts_fail("Xbox Live returned no token");
    }
    let token = body["Token"] as string;
    signal<string>("account_xbl_token").set(token);

    // The user hash sits in a nested claim list.
    let uhs = "";
    if body.contains("DisplayClaims") {
        let claims = body["DisplayClaims"] as {string: any};
        if claims.contains("xui") {
            let xui = claims["xui"] as any[];
            for entry in xui {
                let e = entry as {string: any};
                if e.contains("uhs") {
                    uhs = e["uhs"] as string;
                }
            }
        }
    }
    signal<string>("account_uhs").set(uhs);
    accounts_progress("Authorising for Minecraft...");

    let payload = "{\"Properties\":{\"SandboxId\":\"RETAIL\",\"UserTokens\":[\""
                + token
                + "\"]},\"RelyingParty\":\"rp://api.minecraftservices.com/\",\"TokenType\":\"JWT\"}";
    accounts_post_json("https://xsts.auth.xboxlive.com/xsts/authorize", payload, "xsts-auth");
    return true;
}

// --- 4. XSTS ----------------------------------------------------------------------

fn accounts_on_xsts(tag: string, response: any) -> bool {
    let r = response as {string: any};
    if (r["ok"] as bool) == false && accounts_is_refusal(r) == false {
        return accounts_fail("Xbox Live could not be reached");
    }
    let raw = r["body"] as string;
    let parsed = lumen::parse_json(raw);
    if (parsed is {string: any}) == false {
        if (r["ok"] as bool) == false {
            return accounts_refused("Xbox Live refused the authorisation.");
        }
        return accounts_fail("Xbox Live's authorisation could not be read");
    }
    let body = parsed as {string: any};
    if (r["ok"] as bool) == false {
        let reason = "Xbox Live refused the authorisation.";
        if body.contains("XErr") {
            // XErr is past the range of an int, so it is compared as text.
            let code = json::stringify(body["XErr"]);
            if code == "2148916233" {
                reason = "This Microsoft account has no Xbox profile. Create one at xbox.com, then sign in again.";
            } else if code == "2148916235" {
                reason = "Xbox Live is not available in this account's country.";
            } else if code == "2148916238" {
                reason = "This account is a child account and needs to be added to a family.";
            } else {
                reason = "Xbox Live refused the authorisation (" + code + ").";
            }
        }
        return accounts_refused(reason);
    }
    if body.contains("Token") == false {
        return accounts_fail("Xbox Live returned no authorisation");
    }
    let xsts = body["Token"] as string;
    let uhs = signal<string>("account_uhs").get();
    accounts_progress("Signing in to Minecraft...");

    let payload = "{\"identityToken\":\"XBL3.0 x=" + uhs + ";" + xsts + "\"}";
    accounts_post_json("https://api.minecraftservices.com/authentication/login_with_xbox",
                       payload, "mc-login");
    return true;
}

// --- 5. Minecraft token, then the profile ------------------------------------------

fn accounts_on_mc_login(tag: string, response: any) -> bool {
    let r = response as {string: any};
    if (r["ok"] as bool) == false {
        if accounts_is_refusal(r) {
            return accounts_refused("Minecraft services refused the sign-in.");
        }
        return accounts_fail("Minecraft services could not be reached");
    }
    let raw = r["body"] as string;
    let parsed = lumen::parse_json(raw);
    if (parsed is {string: any}) == false {
        return accounts_fail("The Minecraft sign-in reply could not be read");
    }
    let body = parsed as {string: any};
    if body.contains("access_token") == false {
        return accounts_fail("Minecraft services returned no token");
    }
    // A day, as Mojang issues them, when the reply does not say.
    let lifetime = 86400;
    if body.contains("expires_in") && body["expires_in"] is int {
        lifetime = body["expires_in"] as int;
    }
    signal<int>("account_mc_expires_at").set(time::now() + lifetime);
    signal<string>("account_mc_token").set(body["access_token"] as string);
    accounts_progress("Reading the profile...");
    accounts_get("https://api.minecraftservices.com/minecraft/profile",
                 "mc-profile", signal<string>("account_mc_token").get());
    return true;
}

fn accounts_on_profile(tag: string, response: any) -> bool {
    let r = response as {string: any};
    let status = r["status"] as int;
    if status == 404 {
        return accounts_refused("This account does not own Minecraft: Java Edition.");
    }
    if (r["ok"] as bool) == false {
        if accounts_is_refusal(r) {
            return accounts_refused("The Minecraft profile could not be read.");
        }
        return accounts_fail("Minecraft services could not be reached");
    }
    let raw = r["body"] as string;
    let parsed = lumen::parse_json(raw);
    if (parsed is {string: any}) == false {
        return accounts_fail("The Minecraft profile could not be read");
    }
    let body = parsed as {string: any};
    if body.contains("name") == false {
        return accounts_fail("The Minecraft profile carried no name");
    }
    let name = body["name"] as string;
    let uuid = accounts_dash_uuid(body["id"] as string);
    if signal<string>("account_mode").get() == "refresh" {
        return accounts_store_refreshed(name, uuid);
    }
    return accounts_store(name, uuid);
}

// The profile gives a UUID with the dashes stripped; the game wants them back.
fn accounts_dash_uuid(raw: string) -> string {
    if raw.len() != 32 {
        return raw;
    }
    return raw[..8] + "-" + raw[8..12] + "-" + raw[12..16] + "-" + raw[16..20] + "-" + raw[20..32];
}

// Signing in to an account that is already stored replaces its tokens rather
// than adding a second copy of the same player.
fn accounts_store(name: string, uuid: string) -> bool {
    let d = accounts_read_doc();
    let m = d as {string: any};
    let list = accounts_list_of(d);

    let at = -1;
    let i = 0;
    for entry in list {
        let a = entry as {string: any};
        if (a["uuid"] as string) == uuid {
            at = i;
        }
        i = i + 1;
    }

    let id = "acct-" + string(m["next_seq"] as int);
    if at >= 0 {
        id = (list[at] as {string: any})["id"] as string;
        list.remove(at);
    } else {
        m["next_seq"] = (m["next_seq"] as int) + 1;
    }

    let rm = new_map();
    rm["id"] = id;
    rm["type"] = "msa";
    rm["name"] = name;
    rm["uuid"] = uuid;
    list.push(rm);

    m["active"] = id;
    accounts_set_tokens(id, signal<string>("account_mc_token").get(),
                        signal<string>("account_refresh_token").get(),
                        signal<int>("account_mc_expires_at").get());
    accounts_persist(d);
    accounts_clear_secrets();

    signal<string>("account_flow").set("");
    signal<string>("account_mode").set("");
    signal<string>("account_status").set("Signed in as " + name);
    signal<string>("status").set("Signed in as " + name);
    accounts_refresh();
    return true;
}

// A refresh keeps the account as it is, with new tokens. The name is taken
// from the profile again, since a player can rename themselves.
fn accounts_store_refreshed(name: string, uuid: string) -> bool {
    let id = signal<string>("account_refresh_id").get();
    let after = signal<string>("account_after_refresh").get();
    let d = accounts_read_doc();
    let list = accounts_list_of(d);
    let at = accounts_find(list, id);
    if at < 0 || ((list[at] as {string: any})["uuid"] as string) != uuid {
        // The account was removed while the refresh ran, or the tokens belong
        // to another player; neither is kept.
        return accounts_refresh_failed(false, "");
    }
    let a = list[at] as {string: any};
    a["name"] = name;
    accounts_set_tokens(id, signal<string>("account_mc_token").get(),
                        signal<string>("account_refresh_token").get(),
                        signal<int>("account_mc_expires_at").get());
    accounts_persist(d);
    accounts_clear_secrets();
    signal<string>("account_mode").set("");
    signal<string>("account_refresh_id").set("");
    signal<string>("account_after_refresh").set("");
    accounts_refresh();
    if after != "" {
        accounts_continue(after, false, "");
    }
    return true;
}

// The intermediate tokens have done their job by now, and there is no reason
// to leave them in signals the devtools can read.
fn accounts_clear_secrets() -> bool {
    signal<string>("account_device_code").set("");
    signal<string>("account_msa_token").set("");
    signal<string>("account_xbl_token").set("");
    signal<string>("account_uhs").set("");
    signal<string>("account_mc_token").set("");
    signal<string>("account_refresh_token").set("");
    signal<int>("account_mc_expires_at").set(0);
    return true;
}

// --- Picking and removing --------------------------------------------------------

fn accounts_row_id(id: string) -> string {
    let cut = id.index_of("|").unwrap_or(-1);
    return id[cut + 1..id.len()];
}

fn accounts_use_clicked(id: string) -> bool {
    let acct = accounts_row_id(id);
    let d = accounts_read_doc();
    let m = d as {string: any};
    m["active"] = acct;
    accounts_persist(d);
    accounts_refresh();
    accounts_refresh_if_due(accounts_startup_margin(), "");
    return true;
}

fn accounts_drop_clicked(id: string) -> bool {
    let acct = accounts_row_id(id);
    let d = accounts_read_doc();
    let m = d as {string: any};
    let list = accounts_list_of(d);
    let at = accounts_find(list, acct);
    if at < 0 {
        return false;
    }
    list.remove(at);
    if (m["active"] as string) == acct {
        m["active"] = "";
    }
    accounts_persist(d);
    accounts_drop_tokens(acct);
    accounts_refresh();
    return true;
}
