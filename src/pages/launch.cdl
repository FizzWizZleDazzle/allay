import "lumen.cdl";

// Starting the game. The version metadata already on disk says which class to
// run, which jars belong on the classpath, and which arguments the game
// expects; with a mod loader, the loader's launch profile adds its own
// libraries and arguments and names the class to run instead. This file turns
// that into one process::start call and streams the child's output into the
// profile panel.
//
// The game runs in its game directory, so its log and crash reports land
// beside its saves. It keeps running when Allay closes.

// The player the game is launched as. With an account signed in these read
// its profile; with none they fall back to offline play, which the game
// accepts in singleplayer and on servers that do not check.
fn launch_player() -> string {
    let a = as_map(accounts_active());
    if a.contains("name") {
        return as_str(a.get("name"));
    }
    return "Player";
}

fn launch_uuid() -> string {
    let a = as_map(accounts_active());
    if a.contains("uuid") {
        return as_str(a.get("uuid"));
    }
    return "0f4c1f2e-9a3b-4c5d-8e6f-7a8b9c0d1e2f";
}

fn launch_token() -> string {
    let a = as_map(accounts_active());
    if a.contains("access_token") {
        return as_str(a.get("access_token"));
    }
    return "0";
}

// The game treats "msa" as a signed-in session and "legacy" as offline play.
fn launch_user_type() -> string {
    let a = as_map(accounts_active());
    if a.contains("type") {
        if as_str(a.get("type")) == "msa" {
            return "msa";
        }
    }
    return "legacy";
}

fn launch_init() -> bool {
    signal<string>("launch_running").set("");
    signal<string>("launch_profile").set("");
    signal<string>("launch_log").set("");
    signal<string>("java_version").set("");
    // The probe's own output tells us whether java is on PATH at all.
    let probe_args = ["-version"];
    let started = process::start("java", probe_args, "java-probe", Default::default());
    if started == false {
        signal<string>("java_version").set("java was not found on PATH");
    }
    return true;
}

// --- Assembling the command ---------------------------------------------------

fn launch_read_version(version: string) {
    let raw = files::read(install_version_json(version));
    return lumen::parse_json(raw);
}

// A library's identity without its version: group and artifact, plus the
// classifier when there is one. A loader brings newer builds of some libraries
// the game also lists, and the loader's copy is the one that goes on the
// classpath.
fn launch_lib_key(name: string) -> string {
    let parts = name.split(":");
    if parts.len() < 3 {
        return name;
    }
    let key = as_str(parts[0]) + ":" + as_str(parts[1]);
    if parts.len() > 3 {
        key = key + ":" + as_str(parts[3]);
    }
    return key;
}

// The loader's libraries, as classpath entries, and the keys they claim.
fn launch_loader_classpath(loader, taken) -> string {
    let cp = "";
    if loader.contains("libraries") == false {
        return cp;
    }
    let libs = as_list(loader.get("libraries"));
    for entry in libs {
        let lib = as_map(entry);
        let name = as_str(lib.get("name"));
        let path = maven_path(name);
        if path == "" {
            continue;
        }
        taken.insert(launch_lib_key(name), true);
        cp = cp + libraries_dir() + "/" + path + ":";
    }
    return cp;
}

// The classpath is every library this system uses plus the client jar. From
// 1.19 on that includes the native jars: LWJGL unpacks its own shared
// libraries from them into the directory the jvm arguments name. Older
// versions list their native jars through classifiers only, with no artifact
// to put here; install.cdl unpacks those instead.
fn launch_classpath(root, version: string, taken) -> string {
    let cp = "";
    for entry in as_list(root.get("libraries")) {
        let lib = as_map(entry);
        if install_lib_allowed(lib) == false || lib.contains("downloads") == false {
            continue;
        }
        let name = as_str(lib.get("name"));
        if taken.contains(launch_lib_key(name)) {
            continue;
        }
        let downloads = as_map(lib.get("downloads"));
        if downloads.contains("artifact") == false {
            continue;
        }
        let artifact = as_map(downloads.get("artifact"));
        cp = cp + libraries_dir() + "/" + as_str(artifact.get("path")) + ":";
    }
    return cp + install_client_jar(version);
}

fn launch_substitute(value: string, version: string, root, game_dir: string, classpath: string) -> string {
    let asset_id = "";
    if root.contains("assetIndex") {
        let index = as_map(root.get("assetIndex"));
        asset_id = as_str(index.get("id"));
    }
    let out = value;
    out = out.replace("${auth_player_name}", launch_player());
    out = out.replace("${version_name}", version);
    out = out.replace("${game_directory}", game_dir);
    out = out.replace("${assets_root}", assets_dir());
    out = out.replace("${game_assets}", assets_dir());
    out = out.replace("${assets_index_name}", asset_id);
    out = out.replace("${auth_uuid}", launch_uuid());
    out = out.replace("${auth_access_token}", launch_token());
    out = out.replace("${auth_session}", launch_token());
    out = out.replace("${clientid}", "");
    out = out.replace("${auth_xuid}", "");
    out = out.replace("${user_type}", launch_user_type());
    out = out.replace("${user_properties}", "{}");
    out = out.replace("${version_type}", as_str(root.get("type")));
    out = out.replace("${natives_directory}", install_natives_dir(version));
    out = out.replace("${launcher_name}", "allay");
    out = out.replace("${launcher_version}", "0.1.0");
    out = out.replace("${classpath_separator}", ":");
    out = out.replace("${classpath}", classpath);
    out = out.replace("${library_directory}", libraries_dir());
    return out;
}

// An argument list mixes plain strings with objects carrying rules. The rules
// gate optional features the launcher does not offer (demo mode, a forced
// resolution), so only the plain strings are taken.
fn launch_collect_args(args, out, version: string, root, game_dir: string, classpath: string) -> bool {
    let items = as_list(args);
    for item in items {
        if is_str(item) {
            let filled = launch_substitute(as_str(item), version, root, game_dir, classpath);
            out.push(filled);
        }
    }
    return true;
}

// --- Starting -----------------------------------------------------------------

// `loader_id` names a launch profile in the loaders directory, or is empty for
// the game as Mojang ships it.
fn launch_start(profile_id: string, version: string, loader_id: string, memory_mb: int, game_dir: string) -> bool {
    if signal<string>("launch_running").get() != "" {
        signal<string>("status").set("A game is already running");
        return false;
    }
    let state = install_state(version);
    if state == "partial" {
        signal<string>("status").set(version + " is missing files. Install it again to fetch them");
        return false;
    }
    if state != "installed" {
        signal<string>("status").set(version + " is not installed yet");
        return false;
    }

    let parsed = launch_read_version(version);
    if is_map(parsed) == false {
        signal<string>("status").set("The metadata for " + version + " could not be read");
        return false;
    }
    let root = as_map(parsed);

    let loader = new_map();
    if loader_id != "" {
        let lparsed = lumen::parse_json(files::read(loaders_dir() + "/" + loader_id + ".json"));
        if is_map(lparsed) == false {
            signal<string>("status").set("The launch profile " + loader_id + " could not be read");
            return false;
        }
        loader = as_map(lparsed);
    }

    files::mkdir(game_dir);

    let taken = new_map();
    let classpath = launch_loader_classpath(loader, taken) + launch_classpath(root, version, taken);
    let args = [];

    if root.contains("arguments") {
        let arguments = as_map(root.get("arguments"));
        if arguments.contains("jvm") {
            launch_collect_args(arguments.get("jvm"), args, version, root, game_dir, classpath);
        }
        launch_loader_args(loader, "jvm", args, version, root, game_dir, classpath);
    } else {
        // Versions older than 1.13 carry no jvm argument template, so the two
        // settings the game needs are spelled out here instead.
        args.push("-Djava.library.path=" + install_natives_dir(version));
        args.push("-cp");
        args.push(classpath);
    }

    args.push("-Xmx" + str(memory_mb) + "M");
    let extra = signal<string>("jvm_args").get();
    if extra.trim() != "" {
        let words = extra.split(" ");
        for word in words {
            if word != "" {
                args.push(word);
            }
        }
    }

    if loader.contains("mainClass") {
        args.push(as_str(loader.get("mainClass")));
    } else {
        args.push(as_str(root.get("mainClass")));
    }

    if root.contains("arguments") {
        let arguments = as_map(root.get("arguments"));
        if arguments.contains("game") {
            launch_collect_args(arguments.get("game"), args, version, root, game_dir, classpath);
        }
        launch_loader_args(loader, "game", args, version, root, game_dir, classpath);
    } else if root.contains("minecraftArguments") {
        let legacy = as_str(root.get("minecraftArguments"));
        let filled = launch_substitute(legacy, version, root, game_dir, classpath);
        let words = filled.split(" ");
        for word in words {
            if word != "" {
                args.push(word);
            }
        }
    }

    let tag = "game:" + profile_id;
    signal<string>("launch_log").set("");
    let started = process::start("java", args, tag,
        process::StartOptions { cwd: game_dir, ..Default::default() });
    if started == false {
        signal<string>("status").set("java could not be started");
        return false;
    }
    signal<string>("launch_running").set(profile_id);
    signal<string>("launch_profile").set(profile_id);
    signal<string>("status").set("Launched " + version);
    return true;
}

// A loader profile's arguments of one kind, added after the game's own.
fn launch_loader_args(loader, kind: string, args, version: string, root, game_dir: string, classpath: string) -> bool {
    if loader.contains("arguments") == false {
        return false;
    }
    let arguments = as_map(loader.get("arguments"));
    if arguments.contains(kind) == false {
        return false;
    }
    return launch_collect_args(arguments.get(kind), args, version, root, game_dir, classpath);
}

// --- The child's output --------------------------------------------------------

// The panel keeps the tail of the log rather than all of it: a Minecraft run
// writes tens of thousands of lines and the whole history is not worth a
// signal write per line.
fn launch_append(line: string) -> bool {
    let log = signal<string>("launch_log").get();
    let joined = log + line + "\n";
    if joined.len() > 8000 {
        let cut = joined.len() - 8000;
        joined = joined[cut..joined.len()];
    }
    signal<string>("launch_log").set(joined);
    return true;
}

fn on_process_stdout(tag: string, line: string) -> bool {
    if tag == "java-probe" {
        return true;
    }
    return launch_append(line);
}

fn on_process_stderr(tag: string, line: string) -> bool {
    if tag == "java-probe" {
        // `java -version` writes its banner to stderr; the first line names it.
        if signal<string>("java_version").get() == "" {
            signal<string>("java_version").set(line);
        }
        return true;
    }
    return launch_append(line);
}

fn on_process_exit(tag: string, code: int) -> bool {
    if tag == "java-probe" {
        return true;
    }
    signal<string>("launch_running").set("");
    let profile = signal<string>("launch_profile").get();
    signal<string>("status").set("The game exited with code " + str(code));
    profiles_record_played(profile);
    return true;
}
