<root class="app">
  <use template="shell" active="instances">
  <column class="page instances-page" gap="14">

    <row class="instances-head" align="center" gap="12">
      <column gap="2" grow="1">
        <label class="page-title" text="Instances"/>
        <label class="page-sub" bind-text="instances_count_label" text="No instances yet"/>
      </column>
      <button id="inst-create-open" class="btn btn-primary" text="New instance"/>
    </row>

    <label class="instances-status" wrap="word" bind-text="instances_status" text=""/>

    <!-- Create form. The version field takes a version id directly; picking
         one on the versions page fills it in through the `versions_chosen`
         signal. -->
    <if signal="create_open">
      <column class="instances-create" gap="10">
        <label class="card-title" text="New instance"/>
        <row gap="10" align="center">
          <column gap="4" grow="1">
            <label class="field-hint" text="Name"/>
            <input id="inst-new-name" class="control" placeholder="My world" bind-text="new_name"/>
          </column>
          <column gap="4" width="180px">
            <label class="field-hint" text="Game version"/>
            <input id="inst-new-version" class="control" placeholder="1.21.11" bind-text="new_version"/>
          </column>
          <a class="btn btn-quiet" href="/versions">
            <label class="nav-label" text="Browse versions"/>
          </a>
        </row>
        <label class="instances-chosen" wrap="word" bind-text="versions_chosen_text" text=""/>
        <row gap="8" justify="end">
          <button id="inst-create-cancel" class="btn" text="Cancel"/>
          <button id="inst-create-confirm" class="btn btn-primary" text="Create"/>
        </row>
      </column>
    </if>

    <if signal="instances_empty">
      <column class="instances-empty" gap="6" align="center">
        <label class="empty-title" text="No instances yet"/>
        <label class="empty-body" text="Create one to get started."/>
      </column>
    </if>

    <column class="instances-list" gap="10">
      <for each="instances" key="id">
        <row class="instance-card" gap="12" align="center">
          <column gap="4" grow="1">
            <label class="instance-name" wrap="ellipsis" text="{row.name}"/>
            <row gap="8" align="center">
              <label class="instance-version" text="{row.game_version}"/>
              <label class="loader-badge" text="{row.loader}"/>
              <label class="instance-memory" text="{row.memory_label}"/>
            </row>
          </column>
          <button id="play|{row.id}" class="btn btn-primary" text="Play"/>
          <button id="open|{row.id}" class="btn" text="Details"/>
          <button id="ren|{row.id}" class="btn" text="Rename"/>
          <button id="dup|{row.id}" class="btn" text="Duplicate"/>
          <button id="del|{row.id}" class="btn btn-danger" text="Delete"/>
        </row>
      </for>
    </column>

    <if signal="detail_open">
      <column class="instance-detail" gap="10">
        <row align="center" gap="10">
          <column gap="2" grow="1">
            <label class="detail-title" bind-text="detail_name" text=""/>
            <label class="detail-meta" bind-text="detail_summary" text=""/>
          </column>
          <button id="inst-detail-close" class="btn" text="Close"/>
        </row>

        <row gap="10" align="start">
          <column gap="4" width="200px">
            <label class="field-hint" text="Java memory (MB)"/>
            <input id="inst-detail-memory" class="control" placeholder="2048" bind-text="detail_memory"/>
          </column>
          <column gap="4" grow="1">
            <label class="field-hint" text="Notes"/>
            <textarea id="inst-detail-notes" class="control" height="90px" wrap="word"
                      placeholder="Mods, resource packs, anything worth remembering"
                      bind-text="detail_notes"/>
          </column>
        </row>

        <row gap="16">
          <label class="detail-meta" bind-text="detail_created_label" text=""/>
          <label class="detail-meta" bind-text="detail_played_label" text=""/>
        </row>

        <!-- The game's own output, so a crash on startup is readable without
             leaving the launcher. -->
        <if signal="launch_log">
          <scroll class="launch-log">
            <label class="launch-log-text" wrap="word" bind-text="launch_log" text=""/>
          </scroll>
        </if>

        <row gap="8" justify="end">
          <button id="inst-detail-save" class="btn btn-primary" text="Save changes"/>
        </row>
      </column>
    </if>

    <dialog open="rename_open">
      <column class="instances-dialog" gap="12" width="360px">
        <label class="card-title" text="Rename instance"/>
        <input id="inst-rename-input" class="control" autofocus="true" bind-text="rename_value"/>
        <row gap="8" justify="end">
          <button id="inst-rename-cancel" class="btn" text="Cancel"/>
          <button id="inst-rename-ok" class="btn btn-primary" default="true" text="Rename"/>
        </row>
      </column>
    </dialog>

    <dialog open="confirm_open">
      <column class="instances-dialog" gap="12" width="360px">
        <label class="card-title" text="Delete instance"/>
        <label class="empty-body" wrap="word" bind-text="confirm_text" text=""/>
        <row gap="8" justify="end">
          <button id="inst-delete-cancel" class="btn" text="Cancel"/>
          <button id="inst-delete-ok" class="btn btn-danger" default="true" text="Delete"/>
        </row>
      </column>
    </dialog>

  </column>
  </use>

  <script src="pages/instances.cdl" />
  <script src="pages/launch.cdl" />
</root>
