<root class="app">
  <use template="shell" active="profiles">
  <column class="page profiles-page" gap="14">

    <row class="profiles-head" align="center" gap="12">
      <column gap="2" grow="1">
        <label class="page-title" text="Profiles"/>
        <label class="page-sub" bind-text="$profiles_count_label" text="No profiles yet"/>
      </column>
      <button id="prof-create-open" class="btn btn-primary" text="New profile"/>
    </row>

    <label class="profiles-status" wrap="word" bind-text="$profiles_status" text=""/>

    <!-- A profile is not tied to a game version; the version is picked at
         Play. -->
    <!-- <if> and <dialog> name their signal without the leading $ the bind-*
         attributes carry: there the $ stays part of the name, and the gate
         never opens (lumen-fx/lumen#414). -->
    <if signal="create_open">
      <column class="profiles-create" gap="10">
        <label class="card-title" text="New profile"/>
        <row gap="10" align="center">
          <column gap="4" grow="1">
            <label class="field-hint" text="Name"/>
            <input id="prof-new-name" class="control" placeholder="Survival with friends" bind-text="$new_name"/>
          </column>
          <column gap="4" width="180px">
            <label class="field-hint" text="Mod loader"/>
            <dropdown id="prof-new-loader" bind-value="$new_loader" width="180">
              <option value="Vanilla"/>
              <option value="Fabric"/>
              <option value="Quilt"/>
            </dropdown>
          </column>
        </row>
        <label class="field-hint" wrap="word"
               text="Pick the game version when you press Play. Mods follow whichever version you play."/>
        <row gap="8" justify="end">
          <button id="prof-create-cancel" class="btn" text="Cancel"/>
          <button id="prof-create-confirm" class="btn btn-primary" text="Create"/>
        </row>
      </column>
    </if>

    <if signal="profiles_empty">
      <column class="profiles-empty" gap="6" align="center">
        <label class="empty-title" text="No profiles yet"/>
        <label class="empty-body" text="Create one to get started."/>
      </column>
    </if>

    <column class="profiles-list" gap="10">
      <for each="$profiles" key="key">
        <row class="profile-card" gap="12" align="center">
          <column gap="4" grow="1">
            <label class="profile-name" wrap="ellipsis" text="{row.name}"/>
            <row gap="8" align="center">
              <label class="loader-badge" text="{row.loader_label}"/>
              <label class="profile-meta" text="{row.mods_label}"/>
              <label class="profile-meta" text="{row.version_label}"/>
              <label class="profile-meta" text="{row.memory_label}"/>
            </row>
          </column>
          <button id="play|{row.id}" class="btn btn-primary" text="Play"/>
          <button id="open|{row.id}" class="btn" text="Details"/>
          <button id="ren|{row.id}" class="btn" text="Rename"/>
          <button id="dup|{row.id}" class="btn" text="Duplicate"/>
          <button id="del|{row.id}" class="btn btn-danger" text="Delete"/>
        </row>
      </for>
    </column>

    <if signal="detail_open">
      <column class="profile-detail" gap="10">
        <row align="center" gap="10">
          <column gap="2" grow="1">
            <label class="detail-title" bind-text="$detail_name" text=""/>
            <label class="detail-meta" bind-text="$detail_summary" text=""/>
          </column>
          <button id="prof-detail-close" class="btn" text="Close"/>
        </row>

        <row gap="10" align="start">
          <column gap="4" width="180px">
            <label class="field-hint" text="Mod loader"/>
            <dropdown id="prof-detail-loader" bind-value="$detail_loader" width="180">
              <option value="Vanilla"/>
              <option value="Fabric"/>
              <option value="Quilt"/>
            </dropdown>
          </column>
          <column gap="4" width="160px">
            <label class="field-hint" text="Java memory (MB)"/>
            <input id="prof-detail-memory" class="control" placeholder="2048" bind-text="$detail_memory"/>
          </column>
          <column gap="4" grow="1">
            <label class="field-hint" text="Notes"/>
            <textarea id="prof-detail-notes" class="control" height="90px" wrap="word"
                      placeholder="Resource packs, servers, anything worth remembering"
                      bind-text="$detail_notes"/>
          </column>
        </row>

        <row gap="16">
          <label class="detail-meta" bind-text="$detail_created_label" text=""/>
          <label class="detail-meta" bind-text="$detail_played_label" text=""/>
          <label class="detail-meta" bind-text="$detail_dirs_label" text=""/>
        </row>

        <row gap="8" justify="end">
          <button id="prof-detail-save" class="btn btn-primary" text="Save changes"/>
        </row>

        <!-- The mod list. No versions here: each mod resolves to its build
             for the version picked at Play. -->
        <tile class="divider" height="1px"/>
        <label class="card-title" text="Mods"/>
        <label class="field-hint" wrap="word"
               text="An optional mod is left out on a game version it has no build for. A required one keeps the game from starting there instead."/>
        <if signal="detail_mods_empty">
          <label class="empty-body" text="No mods. Search Modrinth below to add some."/>
        </if>
        <column class="mod-list" gap="6">
          <for each="$detail_mods" key="key">
            <row class="mod-row" gap="10" align="center">
              <label class="mod-title" grow="1" wrap="ellipsis" text="{row.title}"/>
              <button id="modreq|{row.id}" class="btn btn-quiet" text="{row.required_label}"/>
              <button id="modrm|{row.id}" class="btn btn-danger" text="Remove"/>
            </row>
          </for>
        </column>
        <label class="profiles-status" wrap="word" bind-text="$mods_status" text=""/>

        <row gap="8" align="center">
          <input id="mods-query" class="control" grow="1" placeholder="Search Modrinth, for example sodium"
                 bind-text="$mods_query"/>
          <button id="mods-search" class="btn btn-outline" text="Search"/>
        </row>
        <label class="profiles-status" wrap="word" bind-text="$mods_search_status" text=""/>
        <column class="mod-list" gap="6">
          <for each="$mods_results" key="id">
            <row class="mod-row" gap="10" align="center">
              <column gap="2" grow="1">
                <row gap="8" align="center">
                  <label class="mod-title" text="{row.title}"/>
                  <label class="profile-meta" text="{row.author}"/>
                  <label class="profile-meta" text="{row.downloads_label}"/>
                </row>
                <label class="mod-description" wrap="word" text="{row.description}"/>
              </column>
              <button id="modadd|{row.id}" class="btn" text="Add"/>
            </row>
          </for>
        </column>

        <!-- The game's own output, so a crash on startup is readable without
             leaving the launcher. -->
        <if signal="launch_log">
          <tile class="divider" height="1px"/>
          <row align="center" gap="10">
            <label class="card-title" grow="1" text="Game output"/>
            <if signal="launch_running">
              <button id="prof-stop" class="btn btn-danger" text="Stop the game"/>
            </if>
          </row>
          <scroll class="launch-log">
            <label class="launch-log-text" wrap="word" bind-text="$launch_log" text=""/>
          </scroll>
        </if>
      </column>
    </if>

    <dialog open="rename_open">
      <column class="profiles-dialog" gap="12" width="360px">
        <label class="card-title" text="Rename profile"/>
        <input id="prof-rename-input" class="control" autofocus="true" bind-text="$rename_value"/>
        <row gap="8" justify="end">
          <button id="prof-rename-cancel" class="btn" text="Cancel"/>
          <button id="prof-rename-ok" class="btn btn-primary" default="true" text="Rename"/>
        </row>
      </column>
    </dialog>

    <dialog open="confirm_open">
      <column class="profiles-dialog" gap="12" width="360px">
        <label class="card-title" text="Delete profile"/>
        <label class="empty-body" wrap="word" bind-text="$confirm_text" text=""/>
        <row gap="8" justify="end">
          <button id="prof-delete-cancel" class="btn" text="Cancel"/>
          <button id="prof-delete-ok" class="btn btn-danger" default="true" text="Delete"/>
        </row>
      </column>
    </dialog>

  </column>
  </use>

  <script src="pages/profiles.cdl" />
  <script src="pages/mods.cdl" />
  <script src="pages/launch.cdl" />
</root>
