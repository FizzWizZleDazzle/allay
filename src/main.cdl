import "lumen.cdl";

// The app shell: where things are kept on disk, the settings the user can
// change, and the handlers the sidebar needs.
//
// Every path the launcher writes hangs off files::data_dir(), which is
// per-app and created on first use. The app directory itself is read-only
// once the launcher is installed, so nothing is written beside the markup.

// --- Where things live -------------------------------------------------------

fn settings_path() -> string {
    return files::data_dir() + "/settings.json";
}

fn instances_path() -> string {
    return files::data_dir() + "/instances.json";
}

fn manifest_cache_path() -> string {
    return files::data_dir() + "/version-manifest.cache";
}

// One directory per installed version, holding its jar and its metadata.
fn versions_dir() -> string {
    return files::data_dir() + "/versions";
}

// Shared between versions, keyed by the maven path Mojang publishes.
fn libraries_dir() -> string {
    return files::data_dir() + "/libraries";
}

// Native libraries, unpacked per version because they are platform jars.
fn natives_dir() -> string {
    return files::data_dir() + "/natives";
}

// The asset index and the objects it names, shared between versions.
fn assets_dir() -> string {
    return files::data_dir() + "/assets";
}

// One game directory per instance, passed to the game as --gameDir.
fn instances_dir() -> string {
    return files::data_dir() + "/instances";
}

fn make_dirs() -> bool {
    files::mkdir(versions_dir());
    files::mkdir(libraries_dir());
    files::mkdir(natives_dir());
    files::mkdir(assets_dir() + "/indexes");
    files::mkdir(assets_dir() + "/objects");
    files::mkdir(instances_dir());
    return true;
}

// --- Lifecycle ---------------------------------------------------------------

// Allay is dark only, so the scheme is set once and never read back.
fn on_start() {
    lumen::set_color_scheme("force-dark");
    make_dirs();
    load_settings();

    let status = signal("status");
    status.set("Ready");
    signal("data_dir_label").set("Everything Allay writes lives in " + files::data_dir());

    lumen::derive("settings_saved",
                  ["jvm_memory", "jvm_args", "game_dir"],
                  "save_settings");
    lumen::derive("jvm_memory_label", ["jvm_memory"], "format_memory");
}

// One on_ready exists across the whole app; every page's setup hangs off it.
fn on_ready() {
    accounts_init();
    versions_init();
    install_init();
    instances_init();
    launch_init();
    lumen::on("click", "home-play", "home_play_clicked");
    home_refresh();
}

// --- Settings ----------------------------------------------------------------

fn load_settings() -> bool {
    let memory = 6144.0;
    let args = "";
    let dir = "";

    let raw = files::read(settings_path());
    if raw.trim() != "" {
        let parsed = lumen::parse_json(raw);
        if is_map(parsed) {
            let cfg = as_map(parsed);
            if cfg.contains("jvm_memory") {
                memory = float(as_str(cfg.get("jvm_memory")));
            }
            if cfg.contains("jvm_args") {
                args = as_str(cfg.get("jvm_args"));
            }
            if cfg.contains("game_dir") {
                dir = as_str(cfg.get("game_dir"));
            }
        }
    }

    signal("jvm_memory").set_float(memory);
    signal("jvm_args").set(args);
    signal("game_dir").set(dir);
    return true;
}

fn save_settings(memory: float, args: string, dir: string) -> string {
    let mb = str((int(memory) / 1024) * 1024);
    let cfg = {"jvm_memory": mb, "jvm_args": args, "game_dir": dir};
    let text = json_stringify(cfg);
    files::write(settings_path(), text);
    return text;
}

fn format_memory(memory: float) -> string {
    let gb = int(memory) / 1024;
    return str(gb) + " GB";
}

// --- Home --------------------------------------------------------------------

// The home page is a summary of what is actually on disk. It is rebuilt
// whenever something it counts changes, rather than being derived, because its
// inputs are files rather than signals.
fn home_refresh() -> bool {
    let d = instances_read_doc();
    let list = instances_of(d);
    signal("home_instance_count").set(str(list.len()));

    let versions = files::list(versions_dir());
    signal("home_version_count").set(str(versions.len()));

    let accounts = accounts_list_of(accounts_read_doc());
    signal("home_account_count").set(str(accounts.len()));

    return home_pick_last(list);
}

// candela does not order strings, so the stamp is reduced to the number its
// digits spell. The format is fixed-width, so the ordering is the same.
fn stamp_key(stamp: string) -> int {
    let digits = stamp.replace("-", "").replace(" ", "").replace(":", "");
    if is_int(digits) == false {
        return 0;
    }
    return int(digits);
}

// The card shows whichever instance was played most recently, and the first
// one in the list until any of them has been played.
fn home_pick_last(list) -> bool {
    signal("home_has_instance").set("");
    signal("home_no_instance").set("1");
    if list.len() == 0 {
        return true;
    }

    let best = as_map(list[0]);
    let best_stamp = "";
    let best_key = -1;
    for entry in list {
        let m = as_map(entry);
        let stamp = as_str(m.get("last_played"));
        let key = stamp_key(stamp);
        if key > best_key {
            best_key = key;
            best_stamp = stamp;
            best = m;
        }
    }

    signal("home_last_id").set(as_str(best.get("id")));
    signal("home_last_name").set(as_str(best.get("name")));
    signal("home_last_version").set(as_str(best.get("game_version")));
    signal("home_last_loader").set(as_str(best.get("loader")));

    let mb = as_int(best.get("memory_mb"));
    let played = "never played";
    if best_stamp != "" {
        played = "last played " + best_stamp;
    }
    let installed = "not installed";
    if install_is_installed(as_str(best.get("game_version"))) {
        installed = "installed";
    }
    signal("home_last_meta").set(played + "  -  " + str(mb) + " MB heap  -  " + installed);

    signal("home_has_instance").set("1");
    signal("home_no_instance").set("");
    return true;
}

fn home_play_clicked(id: string) -> bool {
    let iid = signal("home_last_id").get();
    if iid == "" {
        return false;
    }
    return instances_play_clicked("play|" + iid);
}

// --- Shell handlers ----------------------------------------------------------

fn on_click(id: string) {
    if id == "browse-dir" {
        lumen::pick_folder("game-dir");
    }
}

fn on_folder_picked(tag: string, path: string) {
    if tag == "game-dir" {
        if path != "" {
            signal("game_dir").set(path);
            signal("status").set("Game directory set");
        }
    }
}

fn main() {}
