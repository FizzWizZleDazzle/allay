import "lumen.cdl";

// The app shell: where things are kept on disk, the settings the user can
// change, and the handlers the sidebar needs.
//
// Every path the launcher writes hangs off files::data_dir(), which is
// per-app and created on first use. The app directory itself is read-only
// once the launcher is installed, so nothing is written beside the markup.

// --- Where things live -------------------------------------------------------

fn settings_path() -> string {
    return files::data_dir() + "/settings.json";
}

fn profiles_path() -> string {
    return files::data_dir() + "/profiles.json";
}

// Where instances were kept before profiles replaced them. Read once, to carry
// them over, and removed after.
fn legacy_instances_path() -> string {
    return files::data_dir() + "/instances.json";
}

fn legacy_instances_dir() -> string {
    return files::data_dir() + "/instances";
}

fn manifest_cache_path() -> string {
    return files::data_dir() + "/version-manifest.cache";
}

// One directory per installed version, holding its jar and its metadata.
fn versions_dir() -> string {
    return files::data_dir() + "/versions";
}

// Shared between versions, keyed by the maven path Mojang publishes.
fn libraries_dir() -> string {
    return files::data_dir() + "/libraries";
}

// Native libraries, unpacked per version because they are platform jars.
fn natives_dir() -> string {
    return files::data_dir() + "/natives";
}

// The asset index and the objects it names, shared between versions.
fn assets_dir() -> string {
    return files::data_dir() + "/assets";
}

// One directory per profile, and inside it one game directory per game
// version, passed to the game as --gameDir. The settings page can move the
// whole tree somewhere else.
fn profiles_dir() -> string {
    let configured = signal<string>("game_dir").get();
    if configured.trim() != "" {
        return configured;
    }
    return files::data_dir() + "/profiles";
}

// The Fabric and Quilt launch profiles, one JSON file per loader build and
// game version. Their libraries go in the shared libraries directory.
fn loaders_dir() -> string {
    return files::data_dir() + "/loaders";
}

fn make_dirs() -> bool {
    files::mkdir(versions_dir());
    files::mkdir(libraries_dir());
    files::mkdir(natives_dir());
    files::mkdir(assets_dir() + "/indexes");
    files::mkdir(assets_dir() + "/objects");
    files::mkdir(loaders_dir());
    return true;
}

// An empty map or list that takes values of any type. A literal `{}` or `[]`
// takes the type of the first thing put in it, and the documents built here
// mix strings, numbers, flags, and nested maps.
fn new_map() {
    return as_map(lumen::parse_json("{}"));
}

fn new_list() {
    return as_list(lumen::parse_json("[]"));
}

// --- Lifecycle ---------------------------------------------------------------

// Allay is dark only, so the scheme is set once and never read back.
fn on_start() {
    lumen::set_color_scheme("force-dark");
    make_dirs();
    load_settings();

    let status = signal<string>("status");
    status.set("Ready");
    signal<string>("data_dir_label").set("Everything Allay writes lives in " + files::data_dir());

    lumen::derive("settings_saved",
                  ["jvm_memory", "jvm_args", "game_dir"],
                  "save_settings");
    lumen::derive("jvm_memory_label", ["jvm_memory"], "format_memory");
}

// One on_ready exists across the whole app; every page's setup hangs off it.
fn on_ready() {
    accounts_init();
    versions_init();
    install_init();
    profiles_init();
    launch_init();
    lumen::on("click", "home-play", "home_play_clicked");
    lumen::on("click", "browse-dir", "settings_browse_clicked");
    lumen::on("folder_picked", "game-dir", "settings_folder_picked");
    home_refresh();
}

// --- Settings ----------------------------------------------------------------

fn load_settings() -> bool {
    let memory = 6144.0;
    let args = "";
    let dir = "";

    let raw = files::read(settings_path());
    if raw.trim() != "" {
        let parsed = lumen::parse_json(raw);
        if is_map(parsed) {
            let cfg = as_map(parsed);
            if cfg.contains("jvm_memory") {
                memory = float(as_str(cfg.get("jvm_memory")));
            }
            if cfg.contains("jvm_args") {
                args = as_str(cfg.get("jvm_args"));
            }
            if cfg.contains("game_dir") {
                dir = as_str(cfg.get("game_dir"));
            }
        }
    }

    signal<float>("jvm_memory").set(memory);
    signal<string>("jvm_args").set(args);
    signal<string>("game_dir").set(dir);
    return true;
}

fn save_settings(memory: float, args: string, dir: string) -> string {
    let mb = str((int(memory) / 1024) * 1024);
    let cfg = {"jvm_memory": mb, "jvm_args": args, "game_dir": dir};
    let text = json_stringify(cfg);
    files::write(settings_path(), text);
    return text;
}

fn format_memory(memory: float) -> string {
    let gb = int(memory) / 1024;
    return str(gb) + " GB";
}

// --- Home --------------------------------------------------------------------

// The home page is a summary of what is actually on disk. It is rebuilt
// whenever something it counts changes, rather than being derived, because its
// inputs are files rather than signals.
fn home_refresh() -> bool {
    let d = profiles_read_doc();
    let list = profiles_of(d);
    signal<string>("home_profile_count").set(str(list.len()));

    let installed = 0;
    for name in files::list(versions_dir()) {
        if install_is_installed(name) {
            installed = installed + 1;
        }
    }
    signal<string>("home_version_count").set(str(installed));

    let accounts = accounts_list_of(accounts_read_doc());
    signal<string>("home_account_count").set(str(accounts.len()));

    return home_pick_last(list);
}

// The card shows whichever profile was played most recently, and the first
// one in the list until any of them has been played.
fn home_pick_last(list) -> bool {
    signal<string>("home_has_profile").set("");
    signal<string>("home_no_profile").set("1");
    if list.len() == 0 {
        return true;
    }

    // The stamp is fixed-width, so ordering the text orders the times.
    let best = as_map(list[0]);
    let best_stamp = "";
    for entry in list {
        let m = as_map(entry);
        let stamp = as_str(m.get("last_played"));
        if stamp > best_stamp {
            best_stamp = stamp;
            best = m;
        }
    }

    signal<string>("home_last_id").set(as_str(best.get("id")));
    signal<string>("home_last_name").set(as_str(best.get("name")));
    let version = as_str(best.get("game_version"));
    if version == "" {
        version = "no version yet";
    }
    signal<string>("home_last_version").set(version);
    signal<string>("home_last_loader").set(profiles_loader_label(as_str(best.get("loader"))));

    let mb = as_int(best.get("memory_mb"));
    let played = "never played";
    if best_stamp != "" {
        played = "last played " + best_stamp;
    }
    let mods = profiles_mods_of(best).len();
    let mods_label = "no mods";
    if mods == 1 {
        mods_label = "1 mod";
    } else if mods > 1 {
        mods_label = str(mods) + " mods";
    }
    signal<string>("home_last_meta").set(played + "  -  " + mods_label + "  -  " + str(mb) + " MB heap");

    signal<string>("home_has_profile").set("1");
    signal<string>("home_no_profile").set("");
    return true;
}

fn home_play_clicked(id: string) -> bool {
    let iid = signal<string>("home_last_id").get();
    if iid == "" {
        return false;
    }
    return profiles_play_last(iid);
}

// --- Settings page -----------------------------------------------------------

fn settings_browse_clicked(id: string) -> bool {
    lumen::pick_folder("game-dir");
    return true;
}

// A cancelled picker answers with an empty path, which keeps the setting.
fn settings_folder_picked(tag: string, path: string) -> bool {
    if path == "" {
        return false;
    }
    signal<string>("game_dir").set(path);
    signal<string>("status").set("Game directory set");
    return true;
}

fn main() {}
