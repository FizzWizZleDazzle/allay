<root>
  <template name="shell" active="home">
    <column class="shell shell-{active}" width="100%" height="100%">

      <!-- The art covers the whole window, sidebar and status bar included, so
           every panel veils one image instead of each cutting its own hole. -->
      <overlay class="bg-art">
        <image class="bg-image" src="bg/panorama.png" alt="" fit="cover"
               width="100%" height="100%"/>
      </overlay>
      <overlay class="bg-scrim"/>

      <row class="shell-body" width="100%" grow="1">

        <column class="sidebar" width="236px" shrink="0" height="100%">
          <row class="brand" align="center" gap="12">
            <image class="brand-mark" src="icons/allay.svg" alt="" width="30px" height="30px"/>
            <column gap="1">
              <label class="brand-name" text="Allay"/>
              <label class="brand-tag" text="Minecraft launcher"/>
            </column>
          </row>

          <column class="nav" gap="2">
            <label class="nav-section" text="Library"/>
            <a id="nav-home" class="nav-item" href="/">
              <tile class="nav-rail" width="3px"/>
              <label class="nav-label" text="Home"/>
            </a>
            <a id="nav-profiles" class="nav-item" href="/profiles">
              <tile class="nav-rail" width="3px"/>
              <label class="nav-label" text="Profiles"/>
            </a>

            <label class="nav-section" text="Setup"/>
            <a id="nav-versions" class="nav-item" href="/versions">
              <tile class="nav-rail" width="3px"/>
              <label class="nav-label" text="Versions"/>
            </a>
            <a id="nav-accounts" class="nav-item" href="/accounts">
              <tile class="nav-rail" width="3px"/>
              <label class="nav-label" text="Accounts"/>
            </a>
            <a id="nav-settings" class="nav-item" href="/settings">
              <tile class="nav-rail" width="3px"/>
              <label class="nav-label" text="Settings"/>
            </a>
          </column>

          <spacer/>

          <column class="account" gap="10">
            <row align="center" gap="10">
              <tile class="avatar" width="32px" height="32px"/>
              <column gap="1" grow="1">
                <label class="account-name" bind-text="$account_name" text="Not signed in"/>
                <label class="account-meta" bind-text="$account_kind" text="Offline mode"/>
              </column>
            </row>
            <a id="nav-account-link" class="btn btn-quiet btn-block" href="/accounts">
              <label class="nav-label" text="Manage accounts"/>
            </a>
          </column>
        </column>

        <column class="content" grow="1" height="100%">
          <scroll class="content-scroll" grow="1" width="100%">
            <slot/>
          </scroll>
        </column>

      </row>

      <!-- Play asks for a game version, then reports on the profile's mods
           before the game starts. It lives in the shell because the home page
           plays too. -->
      <!-- <if> and <dialog> name their signal without the leading $ the bind-*
           attributes carry: there the $ stays part of the name, and the gate
           never opens (lumen-fx/lumen#414). -->
      <dialog open="play_open">
        <column class="play-dialog" gap="12">
          <label class="card-title" bind-text="$play_title" text=""/>
          <if signal="prep_idle">
            <column gap="8">
              <label class="field-hint" text="Game version"/>
              <row gap="8" align="center">
                <input id="play-version" class="control" grow="1" placeholder="1.21.1"
                       bind-text="$play_version"/>
                <button id="play-latest" class="btn btn-quiet" text="Latest release"/>
              </row>
              <label class="field-hint" wrap="word" width="100%" bind-text="$play_hint" text=""/>
            </column>
          </if>
          <label class="play-report" wrap="word" width="100%" bind-text="$prep_report" text=""/>
          <label class="profiles-status" wrap="word" width="100%" bind-text="$prep_status" text=""/>
          <row gap="8" justify="end">
            <button id="play-cancel" class="btn" text="Close"/>
            <if signal="prep_confirm">
              <button id="play-confirm" class="btn btn-primary" text="Play without them"/>
            </if>
            <if signal="prep_idle">
              <button id="play-go" class="btn btn-primary" default="true" text="Play"/>
            </if>
          </row>
        </column>
      </dialog>

      <row class="statusbar" width="100%" align="center" gap="10">
        <tile class="status-dot" width="7px" height="7px"/>
        <label class="status-text" bind-text="$status" text="Ready"/>
        <spacer/>
        <label class="status-meta" text="allay 0.1.0-dev"/>
      </row>
    </column>
  </template>
</root>
