<root class="app">
  <use template="shell" active="home">
    <column class="page" gap="24">

      <column class="page-header" gap="6">
        <label class="page-eyebrow" text="Welcome back"/>
        <label class="page-title" text="Ready to play"/>
        <label class="page-subtitle" wrap="word"
               text="Pick up where you left off, or set up something new."/>
      </column>

      <row class="hero" gap="20">
        <column id="last-played" class="card card-feature" grow="1" gap="16">
          <row class="badges" gap="8" align="center">
            <label class="badge badge-accent" text="Last played"/>
            <label class="badge" text="Fabric 0.16.5"/>
            <label class="badge" text="1.21.1"/>
          </row>
          <column gap="4">
            <label class="feature-title" text="Skyblock Redux"/>
            <label class="feature-meta" text="4 hours ago  -  128 mods  -  6 GB allocated"/>
          </column>
          <spacer/>
          <row class="cta" gap="10" align="center">
            <button id="play" class="btn btn-primary btn-lg" text="Play"/>
            <button id="play-options" class="btn btn-quiet" text="Edit instance"/>
            <spacer/>
            <label class="feature-hint" text="Launching is not wired up yet"/>
          </row>
        </column>

        <column class="card card-side" width="272px" gap="14">
          <label class="card-title" text="At a glance"/>
          <column class="stat-list" gap="0">
            <row class="stat" align="center">
              <label class="stat-label" grow="1" text="Instances"/>
              <label class="stat-value" text="3"/>
            </row>
            <row class="stat" align="center">
              <label class="stat-label" grow="1" text="Installed versions"/>
              <label class="stat-value" text="5"/>
            </row>
            <row class="stat" align="center">
              <label class="stat-label" grow="1" text="Disk used"/>
              <label class="stat-value" text="12.4 GB"/>
            </row>
          </column>
          <tile class="divider" height="1px"/>
          <button id="new-instance" class="btn btn-outline btn-block" text="New instance"/>
        </column>
      </row>

      <column class="tiles" gap="12">
        <label class="section-title" text="Jump back in"/>
        <row class="tile-grid" gap="12">
          <column id="quick-vanilla" class="card card-quick" grow="1" gap="6">
            <label class="quick-kicker" text="Vanilla"/>
            <label class="quick-title" text="1.21.1"/>
            <label class="quick-meta" text="Ready to launch"/>
          </column>
          <column id="quick-forge" class="card card-quick" grow="1" gap="6">
            <label class="quick-kicker" text="Forge"/>
            <label class="quick-title" text="1.20.1"/>
            <label class="quick-meta" text="Ready to launch"/>
          </column>
          <column id="quick-snapshot" class="card card-quick" grow="1" gap="6">
            <label class="quick-kicker" text="Snapshot"/>
            <label class="quick-title" text="25w03a"/>
            <label class="quick-meta quick-meta-pending" text="Not downloaded"/>
          </column>
        </row>
      </column>

      <column class="card card-flush" gap="0">
        <row class="card-head" align="center" gap="10">
          <label class="card-title" grow="1" text="News"/>
          <label class="badge badge-quiet" text="Offline"/>
        </row>
        <tile class="divider" height="1px"/>
        <column class="empty" gap="8" align="center" justify="center">
          <tile class="empty-mark" width="40px" height="40px"/>
          <label class="empty-title" text="Nothing to show"/>
          <label class="empty-body" wrap="word" text-align="center"
                 text="Allay has not fetched the news feed yet. Sign in or check back once downloads land."/>
        </column>
      </column>

    </column>
  </use>

  <script src="main.cdl"/>
</root>
